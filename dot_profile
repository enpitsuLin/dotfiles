# ~/.profile — POSIX login-shell compatibility layer.
# zsh is the primary shell; this file only serves bash/posix-invoked sessions.
# Tool paths (.local/bin via mise, .cargo/bin) are managed in ~/.zsh/10-paths.zsh.

# Load bashrc for interactive bash sessions
if [ -n "$BASH" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
