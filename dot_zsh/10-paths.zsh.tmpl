path_prepend() {
  local dir="$1"

  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
}

path_append() {
  local dir="$1"

  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$PATH:$dir" ;;
  esac
}

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.cargo/bin"

{{ if eq .chezmoi.os "darwin" }}
# macOS: pnpm global dir and Android SDK live under ~/Library
export PNPM_HOME="$HOME/Library/pnpm"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
{{ else }}
# Linux: XDG-ish locations
export PNPM_HOME="$HOME/.local/share/pnpm"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
{{ end }}

# pnpm 10+ links global bins into $PNPM_HOME itself; legacy links live in $PNPM_HOME/bin
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

if [ -n "$ANDROID_HOME" ] && [ -d "$ANDROID_HOME" ]; then
  path_append "$ANDROID_HOME/platform-tools"
  path_append "$ANDROID_HOME/tools"
  path_append "$ANDROID_HOME/tools/bin"
  path_append "$ANDROID_HOME/emulator"
fi

# WSL: add Windows Cursor to PATH if present
[ -d "/mnt/c/Users/$(whoami)/AppData/Local/Programs/cursor/resources/app/bin" ] && \
  path_prepend "/mnt/c/Users/$(whoami)/AppData/Local/Programs/cursor/resources/app/bin"

unset -f path_prepend path_append
