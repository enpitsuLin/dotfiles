[settings]
auto_install = true
experimental = false
idiomatic_version_file_enable_tools = ["node", "python", "ruby"]
pin = true
python.uv_venv_auto = "source"

[settings.node]

# Global defaults. Project-level mise files can still override these.
[tools]
bun = "latest"
go = "1.25.7"
# Track the latest LTS line (currently 24.x); `latest` would follow odd/non-LTS releases
node = "lts"
"npm:corepack" = "0.34.6"
python = "latest"
uv = "latest"
{{ if eq .chezmoi.os "darwin" }}
# macOS only: daily Ruby (CocoaPods for iOS keeps using the brew-managed ruby;
# it is a hard dependency of the brew cocoapods formula and stays untouched).
ruby = "3.4.10"
{{ end }}
