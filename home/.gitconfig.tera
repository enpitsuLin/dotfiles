[user]
	signingkey = 0672CB8176D09B46A823B81C85C836DC516B372C
	name = {{ vars.git_name | json_encode() }}
	email = {{ vars.git_email | json_encode() }}

[commit]
	gpgsign = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Use the GnuPG in PATH (Homebrew on macOS, distro package on Linux).
[gpg]
	program = gpg
[init]
	defaultBranch = master
[pull]
	rebase = true
[core]
	excludesFile = "~/.gitignore_global"
